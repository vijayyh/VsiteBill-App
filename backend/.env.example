# Copy this file to .env and fill in real values for local development.
# In production (Render), these are set as real environment variables in the
# service's dashboard instead — this file is never deployed.

# Optional locally (has a dev default); required to be a real secret in production.
JWT_SECRET=

# Google Drive sync — see the setup steps for getting these from
# https://console.cloud.google.com/ (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/admin/drive/callback

# Where the Drive-connect OAuth flow redirects back to when it's done.
FRONTEND_URL=http://localhost:5173
