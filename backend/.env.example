# Copy this file to .env and fill in real values for local development.
# In production (Render), these are set as real environment variables in the
# service's dashboard instead — this file is never deployed.

# Optional locally (has a dev default); required to be a real secret in production.
JWT_SECRET=

# Google Drive sync — see the setup steps for getting these from
# https://console.cloud.google.com/ (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/admin/drive/callback

# Where the Drive-connect OAuth flow redirects back to when it's done.
FRONTEND_URL=http://localhost:5173

# S3-compatible object storage (delivery photos) — optional locally; when
# unset, photos are read/written on local disk under backend/uploads/ instead.
# Using Supabase Storage (free, no card required): create a project at
# https://supabase.com, then Project Settings > Storage > "S3 Connection" to
# get the endpoint URL and region, and create an access key/secret there.
# Create the bucket itself from the Storage tab in the project dashboard.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# Reading bill photos (OCR) with Google Cloud Vision — optional; when unset the bill form just
# doesn't fill itself in. Google Cloud Console > APIs & Services: enable the Cloud Vision API
# (billing on), then Credentials > Create credentials > API key, restricted to the Cloud Vision API.
GOOGLE_VISION_API_KEY=
